### JPEG XR reference codec
set(jxr_root "${BLK_THIRD_PARTY}/jxrlib")
set(jxr_sources)
foreach(name adapthuff image strcodec strPredQuant strTransform perfTimerANSI)
    list(APPEND jxr_sources ${jxr_root}/image/sys/${name}.c)
endforeach()
foreach(name decode postprocess segdec strdec strInvTransform strPredQuantDec JXRTranscode)
    list(APPEND jxr_sources ${jxr_root}/image/decode/${name}.c)
endforeach()
foreach(name encode segenc strenc strFwdTransform strPredQuantEnc)
    list(APPEND jxr_sources ${jxr_root}/image/encode/${name}.c)
endforeach()
foreach(name JXRGlue JXRMeta JXRGluePFC JXRGlueJxr)
    list(APPEND jxr_sources ${jxr_root}/jxrgluelib/${name}.c)
endforeach()
add_library(jpeg_xr STATIC ${jxr_sources})
target_include_directories(jpeg_xr SYSTEM PUBLIC
    ${jxr_root}/common/include
    ${jxr_root}/image/sys
    ${jxr_root}/jxrgluelib)
target_compile_definitions(jpeg_xr PUBLIC __ANSI__ DISABLE_PERF_MEASUREMENT)
set_target_properties(jpeg_xr PROPERTIES C_STANDARD 99)
if(MSVC)
    target_compile_options(jpeg_xr PRIVATE /FI${CMAKE_CURRENT_SOURCE_DIR}/cmake/jxr_compat.h)
else()
    target_compile_options(jpeg_xr PRIVATE -include ${CMAKE_CURRENT_SOURCE_DIR}/cmake/jxr_compat.h)
endif()
if(NOT MSVC)
    target_compile_options(jpeg_xr PRIVATE -w)
    target_link_libraries(jpeg_xr PUBLIC m)
endif()
