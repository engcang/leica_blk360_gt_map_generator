file(COPY "${SOURCE}/" DESTINATION "${DEST}")
file(GLOB pages "${DEST}/*.html")
foreach(page IN LISTS pages)
    file(READ "${page}" content)
    string(REPLACE "<head>" "<head><script>window.BLK_RGB=true;</script>" content "${content}")
    string(REPLACE "BLK Studio" "BLK Studio RGB" content "${content}")
    string(REPLACE "Intensity" "RGB" content "${content}")
    string(REPLACE "intensity" "RGB" content "${content}")
    string(REPLACE "laser-return RGB" "camera RGB" content "${content}")
    file(WRITE "${page}" "${content}")
endforeach()
